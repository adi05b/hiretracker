{
  "manifest_version": 3,
  "name": "HireTrack",
  "version": "0.2.0",
  "description": "Track your job applications from anywhere",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
  {
    "matches": [
      "https://www.linkedin.com/jobs/*",
      "https://linkedin.com/jobs/*",
      "https://boards.greenhouse.io/*",
      "https://jobs.lever.co/*",
      "https://www.indeed.com/viewjob*",
      "https://indeed.com/viewjob*",
      "https://www.indeed.com/jobs*",
      "https://www.glassdoor.com/job-listing/*",
      "https://www.glassdoor.com/Job/*",
      "https://app.joinhandshake.com/jobs/*",
      "https://app.joinhandshake.com/stu/jobs/*",
      "https://*.myworkdayjobs.com/*",
      "https://www.simplyhired.com/job/*",
      "https://*.joinhandshake.com/jobs/*",
      "https://*.joinhandshake.com/stu/jobs/*"
    ],
    "js": ["src/content/detector.ts"]
  }
]
}